# Copy to .env.local for local development. NEVER commit .env.local.
# In production every one of these is set in the Vercel dashboard only.

# --- LLM provider ----------------------------------------------------------
# Which service the key below belongs to: `openrouter` (default) or `deepseek`.
# One key variable across providers, because two names would let a DeepSeek key
# sit in the OpenRouter variable and fail confusingly at request time (ADR-023).
#
# IMPORTANT on DeepSeek: it returns token counts but NO cost in the usage block,
# so every call is priced from the rates below and recorded as `estimated` with
# the 1.25x pessimism multiplier. Pacing, degradation and fail-closed are
# unaffected, but the ledger becomes our estimate rather than the provider's
# number, and OpenRouter's /api/v1/generation reconciliation is unavailable.
LLM_PROVIDER=openrouter

# --- LLM access ------------------------------------------------------------
# TWO KEYS, NEVER ONE. See ADR-014.
#   dev    = our own key, topped up at will. Used for ALL local work, every
#            preview deploy, and every eval run.
#   client = the $5 / 7-day key from Cadre. CANNOT BE REGENERATED. It is set
#            ONLY in Vercel's Production environment, and is spent only by
#            real visitors and the live review.
# Locally this is always the dev key. If you are about to paste the client key
# into .env.local, stop -- that is the one mistake with no undo.
# The active provider's key. Each provider accepts its conventional variable name
# first and this generic one as a fallback, so a key provisioned by a platform
# integration under the vendor's own name works without renaming it:
#   openrouter -> OPENROUTER_API_KEY
#   deepseek   -> DEEPSEEK_API_KEY, then OPENROUTER_API_KEY
# With DEEPSEEK_API_KEY set and no OpenRouter key, LLM_PROVIDER is inferred as
# `deepseek` and the model defaults to deepseek-chat.
OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Which budget profile this deployment is running. Drives the ledger
# namespace, so dev spend can never be counted against the client's $5 and
# can never move the client's pacing or degradation tier.
#   local + preview -> dev
#   production      -> client
OPENROUTER_KEY_PROFILE=dev
# Sent to OpenRouter for attribution; safe to be public.
OPENROUTER_APP_URL=https://example.vercel.app
OPENROUTER_APP_TITLE=Cadre AI Support Assistant

# --- Model tiers (see docs/model-selection.md) -----------------------------
# Pinned ids only. Never a "~latest" alias: it can change model, price and
# behaviour mid-window and silently invalidate the budget math (ADR-013).
MODEL_PRIMARY=google/gemini-3.8-flash
MODEL_ECONOMY=google/gemini-3.1-flash-lite

# Per-token rates, USD per million tokens. REQUIRED for any model whose price we
# have not captured in docs/model-selection.md §1 -- which is every DeepSeek
# model. Read them off the provider's live pricing page; do not guess. A wrong
# rate silently under-counts real money, which is the one direction this project
# cannot afford to be wrong in. Unset, an unknown model falls back to the most
# expensive captured rates ($1.00 / $5.00), which degrades the bot early rather
# than overspending. Both the input and output rate must be set together.
# MODEL_PRIMARY_INPUT_PER_MTOK=
# MODEL_PRIMARY_OUTPUT_PER_MTOK=
# MODEL_PRIMARY_CACHED_INPUT_PER_MTOK=
# MODEL_ECONOMY_INPUT_PER_MTOK=
# MODEL_ECONOMY_OUTPUT_PER_MTOK=

# --- Ledger store (Supabase Postgres, via the PostgREST API) ---------------
# Use the REST API, not a direct Postgres connection: serverless opens many
# short-lived connections and REST connections establish far faster.
SUPABASE_URL=
# SERVICE ROLE key. Server-side only, never NEXT_PUBLIC_. RLS is enabled with
# no public policies, so the anon key cannot read the ledger or the leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Governor (see docs/governor-spec.md) ----------------------------------
GOVERNOR_TOTAL_BUDGET_USD=5.00
GOVERNOR_RESERVE_USD=1.20
# ISO-8601 UTC. The live-review window; the reserve is unspendable outside it.
# Review: Wed 23 Sep 2026, 17:00-18:00 ART (UTC-3) = 20:00-21:00Z.
# Window runs 14:00-22:00 ART: 3h of margin before (pre-demo smoke tests count
# as review-day spend) and 4h after (the session can run long). Still far
# tighter than the 18h placeholder used before the timezone was confirmed.
GOVERNOR_RESERVE_WINDOW_START=2026-09-23T17:00:00Z
GOVERNOR_RESERVE_WINDOW_END=2026-09-24T01:00:00Z

# ISO-8601 UTC. The pacing horizon. Set this to whichever comes FIRST: the
# key's real expiry, or the end of the review window. Pacing exists to keep
# the bot alive until the review, so a horizon past the review just spreads
# money over days that no longer matter. CONFIRM the real expiry with whoever
# issues the key -- a $5/7-day key issued on 16 Sep expires ON review day.
GOVERNOR_KEY_EXPIRES_AT=2026-09-24T01:00:00Z

# --- Demo simulation -------------------------------------------------------
# MUST be unset in production. Simulated state is read-only and never writes
# to the real ledger; every response is badged "simulated".
GOVERNOR_SIM_ENABLED=false
GOVERNOR_SIM_SPENT_USD=
GOVERNOR_SIM_TIER=

# --- Telemetry -------------------------------------------------------------
# Random 32+ byte secret. Salts the HMAC used for session/IP hashes so neither
# is ever stored in the clear. Rotating it only breaks grouping, nothing else.
TELEMETRY_SALT=

# --- Evals (see .claude/commands/eval.md) ----------------------------------
# Evals run on the DEV key (OPENROUTER_KEY_PROFILE=dev), so this cap protects
# our own wallet, not the client's $5. It stays in place because a runaway
# eval loop is still worth stopping.
EVAL_BUDGET_USD=2.00
